# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# C++ files
[*.{cpp,ixx,h,hpp}]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = crlf

# JSON files
[*.json]
charset = utf-8
indent_style = space
indent_size = 2

# CSV files
[*.csv]
charset = utf-8

# HLSL shader files
[*.{hlsl,cso,pso,vso}]
charset = utf-8
indent_style = space
indent_size = 4

# Batch files
[*.bat]
charset = utf-8
end_of_line = crlf

# Markdown files
[*.md]
charset = utf-8
trim_trailing_whitespace = false

# HTML files
[*.html]
charset = utf-8
indent_style = space
indent_size = 2
